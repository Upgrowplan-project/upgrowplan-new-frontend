{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "upgrowplan.com" }],
      "destination": "https://www.upgrowplan.com/:path*",
      "permanent": true
    }
  ]
}
